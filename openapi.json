            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller's groups do not allow this request."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Get the race info",
        "tags": [
          "Race info"
        ]
      },
      "put": {
        "description": "Uploads the race CSV with the header race,number,name,... (comma separated). race and number are integers, minimum 0. Every row is validated first. One invalid row rejects the whole upload with 400 and nothing is written. Boats missing from the upload are soft deleted. Content-Type must be text/csv. Roles: Admin, Regattaleitung.",
        "operationId": "putRaceInfo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RaceInfoUploaded"
                }
              }
            },
            "description": "CSV processed."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller's groups do not allow this request."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Upload the race info",
        "tags": [
          "Race info"
        ]
      }
    },
