              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "List timings of a station",
        "tags": [
          "Timings"
        ]
      },
      "post": {
        "description": "Records a passing time at a station. Roles: Admin, or the station's own group (Zeitnahme_Start for start, Zeitnahme_3000m for 3000m, Zeitnahme_6000m for 6000m). Idempotent per entry_id: a repeat returns 200 with status duplicate. Corrections are new entries, the latest recorded_at wins.",
        "operationId": "postTiming",
        "parameters": [
          {
            "description": "Timing station. start, 3000m or 6000m.",
            "in": "path",
            "name": "station",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Station",
              "description": "Timing station. start, 3000m or 6000m."
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimingInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimingCreated"
                }
              }
            },
            "description": "Entry already exists."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimingCreated"
                }
              }
            },
            "description": "Entry created."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
