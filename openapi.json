{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "examples": [
              "forbidden"
            ],
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExportFormat": {
        "enum": [
          "csv",
          "trz"
        ],
        "title": "ExportFormat",
        "type": "string"
      },
      "Information": {
        "description": "The one information text for all timing clients, such as contact phone numbers.\n\nNot for urgent announcements. Before the first write it is an empty text and the epoch.",
        "properties": {
          "text": {
            "description": "Plain text, 0 to 300 characters.",
            "title": "Text",
            "type": "string"
          },
          "updated_at": {
            "description": "Server time of the last write, UTC. 1970-01-01T00:00:00Z before the first write.",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "text",
          "updated_at"
        ],
        "title": "Information",
        "type": "object"
      },
      "InformationInput": {
        "additionalProperties": false,
        "description": "Body of `POST /information`.",
        "properties": {
          "text": {
            "description": "Information text, plain text, 0 to 300 characters. An empty text clears the information. The client decides how to display it. Meant for static or seldom changing information such as contact phone numbers, not for urgent announcements.",
            "maxLength": 300,
            "minLength": 0,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "InformationInput",
        "type": "object"
      },
      "InitDatabaseRequest": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "enum": [
              "timings",
              "race_info",
              "all"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "scope"
        ],
        "title": "InitDatabaseRequest",
        "type": "object"
      },
      "InitDatabaseResult": {
        "properties": {
          "deleted": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Deleted",
            "type": "object"
          },
          "scope": {
            "enum": [
              "timings",
              "race_info",
              "all"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "deleted"
        ],
        "title": "InitDatabaseResult",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "groups": {
            "items": {
              "type": "string"
            },
            "title": "Groups",
            "type": "array"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "groups"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "RaceInfoItem": {
        "description": "A stored race info row.",
        "properties": {
          "boat_number": {
            "title": "Boat Number",
            "type": "integer"
          },
          "club": {
            "title": "Club",
            "type": "string"
          },
          "deleted": {
            "title": "Deleted",
            "type": "boolean"
          },
          "distance": {
            "title": "Distance",
            "type": "string"
          },
          "planned_start": {
            "description": "Planned start, time of day, for example 11:02:00.",
            "format": "time",
            "title": "Planned Start",
            "type": "string"
          },
          "race_name": {
            "title": "Race Name",
            "type": "string"
          },
          "race_number": {
            "title": "Race Number",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "boat_number",
          "planned_start",
          "club",
          "race_number",
          "race_name",
          "distance",
          "deleted",
          "updated_at"
        ],
        "title": "RaceInfoItem",
        "type": "object"
      },
      "RaceInfoList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RaceInfoItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "RaceInfoList",
        "type": "object"
      },
      "RaceInfoUploaded": {
        "properties": {
          "deleted": {
            "description": "Boats soft deleted because they are missing in the CSV.",
            "title": "Deleted",
            "type": "integer"
          },
          "uploaded": {
            "title": "Uploaded",
            "type": "integer"
          }
        },
        "required": [
          "uploaded",
          "deleted"
        ],
        "title": "RaceInfoUploaded",
        "type": "object"
      },
      "Station": {
        "enum": [
          "start",
          "3000m",
          "6000m"
        ],
        "title": "Station",
        "type": "string"
      },
      "StatusResponse": {
        "properties": {
          "name": {
            "examples": [
              "RVEBackend"
            ],
            "title": "Name",
            "type": "string"
          },
          "version": {
            "examples": [
              "2.1.0"
            ],
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "TimingCreated": {
        "properties": {
          "entry_id": {
            "format": "uuid",
            "title": "Entry Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "created",
              "duplicate"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "entry_id"
        ],
        "title": "TimingCreated",
        "type": "object"
      },
      "TimingInput": {
        "additionalProperties": false,
        "description": "Body of `POST /timings/{station}`.",
        "properties": {
          "boat_number": {
            "description": "Boat number, integer, minimum 0.",
            "minimum": 0.0,
            "title": "Boat Number",
            "type": "integer"
          },
          "deleted": {
            "default": false,
            "description": "True marks this entry as a delete marker: the boat is treated as deleted while this is its latest entry (by recorded_at). The history is kept. A later normal entry brings the boat back.",
            "title": "Deleted",
            "type": "boolean"
          },
          "entry_id": {
            "description": "Client generated UUID (any version). Reuse it when retrying.",
            "format": "uuid",
            "title": "Entry Id",
            "type": "string"
          },
          "invalidates": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes this entry an invalidation marker: it cancels the entry of the same boat with this entry_id. Cancelled entries and the marker itself are ignored when selecting the current value. The history is kept. Cannot be combined with deleted, and a marker cannot be cancelled. passed_at is optional and ignored.",
            "title": "Invalidates"
          },
          "passed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Client passing time, ISO 8601 with timezone. Times without timezone are rejected. Required unless deleted is true.",
            "title": "Passed At"
          },
          "recorded_at": {
            "description": "Client time of the entry, ISO 8601 with timezone. Times without timezone are rejected.",
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          }
        },
        "required": [
          "entry_id",
          "boat_number",
          "recorded_at"
        ],
        "title": "TimingInput",
        "type": "object"
      },
      "TimingItem": {
        "properties": {
          "boat_number": {
            "title": "Boat Number",
            "type": "integer"
          },
          "current": {
            "description": "True for the latest valid entry (by recorded_at) of the boat. Never true for an invalidation marker or an invalid entry.",
            "title": "Current",
            "type": "boolean"
          },
          "deleted": {
            "default": false,
            "description": "True for a delete marker. Shown in the history like every other entry.",
            "title": "Deleted",
            "type": "boolean"
          },
          "entry_id": {
            "format": "uuid",
            "title": "Entry Id",
            "type": "string"
          },
          "invalid": {
            "description": "True when an invalidation marker of the same boat cancels this entry. Computed when reading, not stored.",
            "title": "Invalid",
            "type": "boolean"
          },
          "invalidates": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set on an invalidation marker: the entry_id of the cancelled entry.",
            "title": "Invalidates"
          },
          "passed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Missing for a delete marker without a passing time.",
            "title": "Passed At"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          }
        },
        "required": [
          "boat_number",
          "entry_id",
          "recorded_at",
          "received_at",
          "invalid",
          "current"
        ],
        "title": "TimingItem",
        "type": "object"
      },
      "TimingList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TimingItem"
            },
            "title": "Items",
            "type": "array"
          },
          "station": {
            "$ref": "#/components/schemas/Station"
          }
        },
        "required": [
          "station",
          "items"
        ],
        "title": "TimingList",
        "type": "object"
      }
    },
    "securitySchemes": {
      "cognitoJwt": {
        "bearerFormat": "JWT",
        "description": "Cognito user pool JWT, sent as 'Authorization: Bearer <token>'. It is checked by the API Gateway JWT authorizer. The roles are the Cognito groups in the cognito:groups claim and are checked in the Lambda code.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Backend for the timing of a rowing regatta. All endpoints need a Cognito JWT.",
    "title": "RVEBackend API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/init-database": {
      "post": {
        "description": "Deletes all items of the chosen scope: timings (all stations), race_info or all. The scope all also deletes the information text. Roles: Admin.",
        "operationId": "initDatabase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitDatabaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitDatabaseResult"
                }
              }
            },
            "description": "Items deleted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller's groups do not allow this request."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Init database",
        "tags": [
          "Admin"
        ]
      }
    },
    "/exports/{station}": {
      "get": {
        "description": "Current value per boat of a station. trz (default) is number, TAB, time with CRLF line endings and no header. csv is 'number;time' with a header line. Time is HH:MM:SS in the timezone of the tz parameter (default Europe/Berlin). Boats without an entry and boats whose latest entry is a delete marker (deleted=true) are not listed. Roles: Admin, Regattaleitung.",
        "operationId": "getExport",
        "parameters": [
          {
            "description": "Timing station. start, 3000m or 6000m.",
            "in": "path",
            "name": "station",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Station",
              "description": "Timing station. start, 3000m or 6000m."
            }
          },
          {
            "description": "trz (text/plain) or csv (text/csv). Default: trz.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ExportFormat"
                },
                {
                  "type": "null"
                }
              ],
              "description": "trz (text/plain) or csv (text/csv). Default: trz.",
              "title": "Format"
            }
          },
          {
            "description": "IANA timezone name (for example Europe/Berlin or UTC). Every time is converted to this timezone and written as HH:MM:SS. Default: Europe/Berlin. Invalid names return 400.",
            "in": "query",
            "name": "tz",
            "required": false,
            "schema": {
              "default": "Europe/Berlin",
              "description": "IANA timezone name (for example Europe/Berlin or UTC). Every time is converted to this timezone and written as HH:MM:SS. Default: Europe/Berlin. Invalid names return 400.",
              "title": "Tz",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Export file, sent as attachment <station>.trz or <station>.csv."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller's groups do not allow this request."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Export a station",
        "tags": [
          "Exports"
        ]
      }
    },
    "/information": {
      "get": {
        "description": "Returns the one information text (plain text) and the time of the last write (UTC). It is meant for static or seldom changing information such as contact phone numbers, not for urgent announcements. Before the first write it returns an empty text and 1970-01-01T00:00:00Z. Roles: any signed in user.",
        "operationId": "getInformation",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Information"
                }
              }
            },
            "description": "The information text."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Read the information text",
        "tags": [
          "Information"
        ]
      },
      "post": {
        "description": "Replaces the one information text (plain text, 0 to 300 characters). It is meant for static or seldom changing information such as contact phone numbers, not for urgent announcements. An empty text clears it. The server sets updated_at. Roles: Admin, Regattaleitung.",
        "operationId": "postInformation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InformationInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Information"
                }
              }
            },
            "description": "The stored information text."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller's groups do not allow this request."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Write the information text",
        "tags": [
          "Information"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "Returns the user name and groups from the token. Roles: any signed in user.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "The caller."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Current user",
        "tags": [
          "Session"
        ]
      }
    },
    "/race-info": {
      "get": {
        "description": "Returns the uploaded race info. Roles: Admin, Zeitnahme_Start, Zeitnahme_3000m, Zeitnahme_6000m, Regattaleitung.",
        "operationId": "getRaceInfo",
        "parameters": [
          {
            "description": "Set to true to include soft deleted boats.",
            "in": "query",
            "name": "includeDeleted",
            "required": false,
            "schema": {
              "default": false,
              "description": "Set to true to include soft deleted boats.",
              "title": "Includedeleted",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RaceInfoList"
                }
              }
            },
            "description": "Race info items."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller's groups do not allow this request."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Get the race info",
        "tags": [
          "Race info"
        ]
      },
      "put": {
        "description": "Uploads the race CSV (semicolon separated) with the header boat_number;planned_start;club;race_number;race_name;distance. Column order does not matter, further columns are ignored. boat_number and race_number are integers, minimum 0, planned_start is a time of day such as 11:02:00. Every row is validated first. One invalid row rejects the whole upload with 400 and nothing is written. Boats missing from the upload are soft deleted. Content-Type must be text/csv. Roles: Admin, Regattaleitung.",
        "operationId": "putRaceInfo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RaceInfoUploaded"
                }
              }
            },
            "description": "CSV processed."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
