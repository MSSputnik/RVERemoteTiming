                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed for this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "security": [
          {
            "cognitoJwt": []
          }
        ],
        "summary": "Record a timing",
        "tags": [
          "Timings"
        ]
      }
    }
