    "/timings/{station}": {
      "get": {
        "description": "Returns the whole partition of a station, all entries with the current one marked. Roles: Admin, Zeitnahme_Start, Zeitnahme_3000m, Zeitnahme_6000m, Regattaleitung (all stations).",
        "operationId": "getTimings",
        "parameters": [
          {
            "description": "Timing station. start, 3000m or 6000m.",
            "in": "path",
            "name": "station",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Station",
              "description": "Timing station. start, 3000m or 6000m."
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimingList"
                }
              }
            },
            "description": "All entries."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input. The message names the first invalid field and what is wrong. Times without timezone, unknown fields and invalid IANA names are rejected."
          },
          "401": {
            "description": "Missing or invalid token (from the API Gateway authorizer)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
